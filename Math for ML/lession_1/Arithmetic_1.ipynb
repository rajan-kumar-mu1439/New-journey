   "source": [
    "# suppose that\n",
    "\"\"\"\n",
    "class room = 100\n",
    "Pass = 20\n",
    "percentage = Pass\n",
    "\"\"\"\n",
    "\n",
    "total_student = 100\n",
    "Pass = 20\n",
    "per = (Pass / total_student)*100\n",
    "print(\"Pass percentage :\",per)\n",
    "print(\"Fall :\", total_student - Pass)"
   ]
